include LICENSE
include README.md
include pyproject.toml
recursive-include mea_editor *.py
recursive-include tests *.py
prune si_env
prune .venv
prune venv
prune dist
prune build
prune *.egg-info
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude *.so
exclude MEA_RdLGN64test.json
exclude uv.lock
